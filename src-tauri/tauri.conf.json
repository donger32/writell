{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writell",
  "version": "0.17.11",
  "identifier": "app.inkwell.writer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Writell",
        "width": 1360,
        "height": 860,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "Writell",
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGOEM2N0EwRjRBRTczQTYKUldTbWM2NzBvR2VNWDNEc3RJWnZNOUo1M0h5RXFsNzRZSm5zLy9uYUxwb2llUkwzNE9wZzFaU0IK",
      "endpoints": [
        "https://github.com/donger32/writell/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
